# Production & Deployment Environment Variables for RailConnect on Render
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database URL (Render PostgreSQL sets this automatically, e.g. postgresql://user:password@host/db)
# If left unset/missing, RailConnect falls back to local SQLite (db.sqlite3)
# DATABASE_URL=postgresql://railconnect_user:password@ep-sample.render.com/railconnect_db

# Staff demo passwords (optional, defaults provided in README if unset)
# ADMIN_DEMO_PASSWORD=YourAdminSecret123
# TTE_DEMO_PASSWORD=YourTteSecret123
# OPS_DEMO_PASSWORD=YourOpsSecret123
